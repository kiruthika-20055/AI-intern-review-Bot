# ---- AI (optional: without key the bot uses built-in rule-based mode) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Email (Gmail: enable 2FA, create "App Password"). Empty = emails saved in /outbox ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_NAME=Intern Review Team

# ---- Review scheduling ----
REVIEW_START_HOUR=10        # first slot 10:00
REVIEW_SLOT_MINUTES=30
SLOTS_PER_DAY=12
DEFAULT_MEET_LINK=https://meet.google.com/your-room-code   # used if Google Calendar API not set up
USE_GOOGLE_CALENDAR=false   # true => real unique Meet link per intern (see README)

APP_BASE_URL=http://127.0.0.1:5000
SECRET_KEY=change-me
